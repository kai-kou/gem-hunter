# gem-hunter の環境変数のひな形
#
# 使い方: `cp .env.example .env.local` してから、必要な分だけ値を入れる（Next.js の規約どおり）。
#
# すべて任意。1 つも設定しなくても `npm run dev` は起動し、検索・詳細表示は動作する
# （その場合 GitHub API を未認証で叩くためレート枠が狭くなる）。
# `npm test` / `npm run test:e2e` も 1 つも設定せずに通る（外部 API はモック化されている）。
#
# 実値・秘密情報を本ファイルに書かないこと（本ファイルはリポジトリで追跡される）。
# 実値はコピー先にだけ書く（追跡対象外）。
#
# 各変数の詳細は README.md「環境変数」節（正本）と docs/rules/env-vars.md を参照。

# --- GitHub App 認証（installation token の取得・ADR 0003）-----------------------
# 下の 3 変数が揃わない限り、未認証で GitHub API を叩く（レート枠が狭い）。
GITHUB_APP_CLIENT_ID=
GITHUB_APP_INSTALLATION_ID=
# PKCS#8 形式で注入する必要がある（改行を含む値は引用符で囲むか \n にエスケープする）
GITHUB_APP_PRIVATE_KEY_PKCS8=

# --- 任意ログイン（GitHub OAuth・ADR 0012）--------------------------------------
# 下の SESSION_ENCRYPTION_KEY を含む 4 変数が揃わない限り、ログイン導線は静かに無効化される
# （未ログイン相当の機能はすべて動く）。判定は src/composition/auth.ts の isAuthConfigured()。
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# デプロイ先ごとに異なる。オープンリダイレクト対策の検証にも使う
GITHUB_OAUTH_CALLBACK_URL=
# ログイン後のセッション Cookie 暗号化鍵（32 バイトを base64url エンコードした値）。
# 本行だけが欠けてもログイン導線ごと無効化される
SESSION_ENCRYPTION_KEY=

# --- レート制限（NFR-7）---------------------------------------------------------
# 検索経路の自リクエスト間引きでクライアント IP を HMAC 化する際の salt。
# 未設定時はレート制限の間引きをしない（フェイルオープン）
RATE_LIMIT_SALT=

# --- サイトの正準オリジン（OG 画像の metadataBase）------------------------------
# 未設定時は本番 URL へフォールバックするため通常は設定不要。
# ビルド時変数: `next build` / `opennextjs-cloudflare build` を実行するシェルの process.env を
# 読んで値がバンドルへ焼き込まれる。ビルド後にランタイム側で変えても反映されない。
SITE_URL=
