# Claude Code local settings (never commit secrets)
.claude/settings.local.json

# Generated session/project state
content/context/project_state.md
content/pipeline-state/
content/analytics/*
# スプリント較正の実測データだけはコミット対象（session-sprint-rules.md §5/§6・#45）
!content/analytics/sprint/
# レトロの見送り Try ログもコミット対象（#417）。次回のレトロが Q1（再発判定）で読み戻す
# 記録であり、追跡されないとクラウドではコンテナ破棄で消えて判定材料が永久に貯まらない。
!content/analytics/retro/
# rejected-edit buffer（skill-creator 本体最適化ループの reject 記録・base#514）
!content/analytics/skillopt/
# PR レビュー近似判定の使用実績サンプルもコミット対象（Issue #806）。倒し方を決める前に
# 実運用データを溜めるための記録で、追跡されないとクラウドではコンテナ破棄で消える。
!content/analytics/pr-review/
# 月次コストレポート（content/analytics/cost_monthly/）は main では追跡しない（#242）。
# 永続化は tools/commit_cost_telemetry.py がテレメトリ専用データブランチ
# telemetry/cost-data へ 1 日 1 回 push する（Stop hook 経由・gh 非依存）。
# gitignore 対象のため feature 差分・未コミット検知には構造的に現れない。

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# OS / editor
.DS_Store
*.swp

# Secrets / env
.env
.env.*
# .env.example はテンプレートで秘密情報を含まないため追跡対象に戻す
!.env.example
*.pem
*.key
.claude/worktrees/

# エフェメラルなローカル DB ファイルを誤って commit しないための一般的な安全網
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.duckdb

# 公開スナップショット抽出時の秘匿語リスト（publish-snapshot.sh が読む）。
# 秘匿語そのものを追跡すると本末転倒なので必ず ignore する。雛形は .publish-secrets.example。
.publish-secrets

# --- Next.js / Node（SP-1 で追加） ---
/node_modules
/.next/
/out/
/coverage
/.open-next/
/playwright-report/
/test-results/
.env
.env*.local
.wrangler/
next-env.d.ts
# `wrangler types` が生成する成果物（14,000 行超）。tsc は参照するがコミット対象にしない。
worker-configuration.d.ts

# 検証用に distDir を変えてビルドしたときの成果物（.next-r5verify 等）を追跡しない
/.next-*/

# TypeScript のインクリメンタルビルド情報（ビルドのたびに変わる生成物・#213 / #82）
tsconfig.tsbuildinfo

# apply-base（scripts/apply-to-repo.sh）が毎回生成する適用アーティファクト。
# `*.base` はプロジェクト固有ファイルの雛形、`*.pre-base.bak` は settings.json の退避で、
# どちらも適用のたびに作り直されるためコミット対象にしない。
# ⚠️ `*.base-latest`（3 方向マージ未解決の要確認ファイル）は **意図的に ignore しない**。
# 取り込んで削除するまで git status に見えている必要がある（apply-base SKILL §3.0）。
*.base
*.pre-base.bak

# ベース専用ツール（本リポジトリでは適用対象外・apply のたびに再配置される）。
# check_distribution_boundary.py はベースリポジトリ自身の配布境界
# （SYNC_PATHS / PUBLISH_PATHS / .claude-plugin/marketplace.json）を検査するもので、
# 本リポジトリは配布元ではなく `scripts/publish-snapshot.sh` を持たないため常に FAIL する。
tools/check_distribution_boundary.py
